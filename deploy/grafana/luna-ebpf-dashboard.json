{
  "id": null,
  "uid": "luna-ebpf-network",
  "title": "luna-ebpf · Host容器网络",
  "description": "0.1.1+，按Socket cgroup归属；bytes是skb长度，packets是Hook次数。",
  "tags": [
    "luna-ebpf",
    "ebpf",
    "docker"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "数据源",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "options": []
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(luna_exporter_up, job)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(luna_exporter_up, job)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "instance",
        "label": "实例",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(luna_exporter_up{job=~\"${job:regex}\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(luna_exporter_up{job=~\"${job:regex}\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "container",
        "label": "容器",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(luna_container_rx_bytes_total{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}, container_name)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(luna_container_rx_bytes_total{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}, container_name)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "采集健康",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "luna_exporter_up{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "异常",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
